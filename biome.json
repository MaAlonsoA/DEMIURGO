{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "packages/**/*.ts",
      "packages/**/*.json",
      "*.ts",
      "*.json",
      "!**/node_modules",
      "!**/generado",
      "!reports",
      "!evals/**/resultados"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 130,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always", "arrowParentheses": "always" }
  },
  "linter": { "enabled": false },
  "assist": { "enabled": false }
}
