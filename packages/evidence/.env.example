# Local secrets of the evidence stack (compose.evidence.yaml). `pnpm evidence:up` creates
# `packages/evidence/.env` next to this file with random values if it does not exist; `.env` is
# git-ignored and must stay so. The viewer is bound to 127.0.0.1, so these only guard the machine.
# JWT signing secret of Phoenix (PHOENIX_SECRET): 64 hex characters.
PHOENIX_SECRET=replace-with-64-hex-characters
# Phoenix admin secret (PHOENIX_ADMIN_SECRET), also the bearer token the collector ingests with.
PHOENIX_SYSTEM_KEY=replace-with-64-hex-characters
# First password of admin@localhost in Phoenix (read on the first start only).
PHOENIX_ADMIN_PASSWORD=replace-me
# Password of evidence@demiurgo.local in Metabase (http://127.0.0.1:3300); `pnpm evidence metabase-setup` creates
# the account with it on the first run and signs in with it afterwards.
METABASE_ADMIN_PASSWORD=replace-me
