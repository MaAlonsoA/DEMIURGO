# Local example for the evidence services in the root compose.yaml. The active values live in the
# root .env file, which is git-ignored. The web admin passwords are admin in this dev stack.
# JWT signing secret of Phoenix (PHOENIX_SECRET): 64 hex characters.
PHOENIX_SECRET=replace-with-64-hex-characters
# Phoenix admin secret (PHOENIX_ADMIN_SECRET), also the bearer token the collector ingests with.
PHOENIX_SYSTEM_KEY=replace-with-64-hex-characters
# First password of admin@localhost in Phoenix (read on the first start only).
PHOENIX_ADMIN_PASSWORD=admin
# Password of admin@demiurgo.local in Metabase (http://127.0.0.1:3300); `pnpm evidence metabase-setup` creates
# the account with it on the first run and signs in with it afterwards.
METABASE_ADMIN_PASSWORD=admin
