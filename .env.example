# Variables del compose único (compose.yaml). Copia este fichero a `.env` (git-ignored). Las
# contraseñas de acceso web de desarrollo son `admin`; genera los secretos de los servicios
# con `openssl rand -hex 32`.
# En el mini, .env lo escribió Claude Code al montar el homelab; la referencia está en ~/.config/demiurgo/secrets.md.

# Postgres de DEMIURGO (servicio postgres, publicado en 127.0.0.1:55433, base demiurgo_v2, usuario demiurgo).
DEMIURGO_DB_PASSWORD=replace-me
# Postgres de evidencia (servicio evidence-db, 127.0.0.1:55434, bases demiurgo_evidence y phoenix, usuario evidence).
EVIDENCE_DB_PASSWORD=replace-me
# Rol de solo lectura evidence_reader (lo usa Metabase; lo crea packages/evidence/postgres/init.sh).
EVIDENCE_READER_PASSWORD=replace-me
# Phoenix: secreto JWT (64 hex), secreto de administración (bearer del colector, 64 hex) y primera contraseña de admin@localhost.
PHOENIX_SECRET=replace-with-64-hex-characters
PHOENIX_SYSTEM_KEY=replace-with-64-hex-characters
PHOENIX_ADMIN_PASSWORD=admin
# URL pública opcional para el enlace de diagnóstico de la web; si falta, se deduce de demiurgo.<dominio>.
PHOENIX_PUBLIC_URL=
# Metabase: contraseña de admin@demiurgo.local (`docker compose run --rm api pnpm evidence metabase-setup` la crea).
METABASE_ADMIN_PASSWORD=admin

# Orígenes que acepta la API (cookie de sesión y CSRF). Con Cloudflare, añade https://demiurgo.<dominio>.
DEMIURGO_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
# real | qa | dev: etiqueta de las notas de observación y del proyecto de Phoenix.
DEMIURGO_ENVIRONMENT=real
# 1 activa instantáneas y el proveedor simulado (es el único entorno del homelab).
DEMIURGO_DEV_TOOLS=1
# URL pública de Metabase (con Cloudflare, https://metabase.<dominio>).
METABASE_SITE_URL=http://127.0.0.1:3300

# Para `pnpm gate:test` desde el host: el mismo Postgres real; las pruebas solo crean bases dmg_t_*.
DEMIURGO_TEST_DB_URL=postgres://demiurgo:replace-me@127.0.0.1:55433/postgres
# uid/gid del usuario del host (para que el contenedor escriba en el repo montado) y gid del socket de Docker en la VM.
DEMIURGO_UID=501
DEMIURGO_GID=501
DOCKER_SOCKET_GID=991

# Ruta en el anfitrión (el Mac) de la carpeta que el contenedor api ve como /projects.
# El constructor monta el worktree de una tarea en su contenedor con esta ruta, porque el
# daemon de Docker vive en el anfitrión. Por defecto: ${HOME}/Development/Demiurgo-projects.
# DEMIURGO_PROJECTS_HOST_DIR=
# Token de GitHub (fine-grained: administración, contenido, pull requests, acciones y estados de commit de los repos) con el que DEMIURGO crea y usa el repo privado de cada proyecto.
DEMIURGO_GITHUB_TOKEN=
# Cuenta u organización de GitHub donde se crean los repos privados de los proyectos.
DEMIURGO_GITHUB_OWNER=
